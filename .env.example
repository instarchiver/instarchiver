# Base URL of the instarchiver-backend Django API.
# Dev:  http://localhost:8000
# Prod: https://api.instarchiver.net
NEXT_PUBLIC_API_URL=http://localhost:8000

# Public URL of this site, used for canonical links, Open Graph and the sitemap.
NEXT_PUBLIC_SITE_URL=https://instarchiver.net

# Optional Google AdSense client ID override (defaults to ca-pub-3865845660755241).
NEXT_PUBLIC_ADSENSE_CLIENT_ID=

# Optional publisher ID override for /ads.txt (defaults to client ID without "ca-").
ADSENSE_PUBLISHER_ID=
